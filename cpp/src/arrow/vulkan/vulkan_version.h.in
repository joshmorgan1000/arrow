#ifndef ARROW_VULKAN_VULKAN_VERSION_H
#define ARROW_VULKAN_VULKAN_VERSION_H

// Vulkan loader version arrow_vulkan was built against (from the system
// `find_package(Vulkan)`). Informational only; runtime resolution always
// goes through the loader.
#define ARROW_VULKAN_LOADER_VERSION_MAJOR @Vulkan_VERSION_MAJOR@
#define ARROW_VULKAN_LOADER_VERSION_MINOR @Vulkan_VERSION_MINOR@
#define ARROW_VULKAN_LOADER_VERSION_PATCH @Vulkan_VERSION_PATCH@

#endif  // ARROW_VULKAN_VULKAN_VERSION_H
